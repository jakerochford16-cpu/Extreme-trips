# Required for the /plan AI trip-planning feature.
# Get a free key at https://aistudio.google.com/apikey — no credit card needed.
GEMINI_API_KEY=

# Required for accounts (sign-in, and syncing favorites/reviews across devices).
# Get free keys at https://clerk.com — Dashboard → API Keys.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Postgres connection for the same account data. A free Supabase project works —
# Project Settings → Database → "Connection pooling" for DATABASE_URL (port 6543)
# and the session-mode pooler for DIRECT_URL (port 5432). Run scripts/schema.sql
# against the database once (e.g. via the Supabase SQL editor) before first use.
DATABASE_URL=
DIRECT_URL=
